# Copiá este archivo a .env.local y completalo con los datos de TU proyecto Supabase
# (Project Settings > API). Solo la URL y la clave "anon" (pública) van en el frontend.
# NUNCA pongas acá la clave "service_role": la app se niega a arrancar si la detecta.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...clave-anon-publica...
